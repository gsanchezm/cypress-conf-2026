    "@cucumber/messages": "^33.0.4",
    "@cypress/cloud": "^0.5.0",
    "@dotenvx/dotenvx": "^2.38.0",
    "@types/node": "^26.2.0",
    "cypress": "^15.21.0",
    "cypress-on-fix": "^1.1.0",
    "esbuild": "^0.28.2",
    "mochawesome": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
