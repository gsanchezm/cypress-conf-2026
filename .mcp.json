{
  "mcpServers": {
    "cypress-cloud": {
      "type": "http",
      "url": "https://mcp.cypress.io/mcp",
      "headers": {
        "Authorization": "Bearer ${CYPRESS_MCP_TOKEN}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/x/actions/readonly",
      "headers": {
        "Authorization": "Bearer ${GH_MCP_PAT}"
      }
    }
  }
}
